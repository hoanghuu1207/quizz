extends ../../layouts/default.pug

block main
  main.main-content
    link(rel='stylesheet', href='/client/css/home.css')
    .container
      .section-header
        h2 All Cards
      .quiz-grid
        each category in categories
          .quiz-card
            .quiz-image
              span.quiz-badge Top
              img(
                alt="Quiz" 
                src="https://placehold.co/450x300/e9ecef/adb5bd?text=Quiz+Image"
              )
            .quiz-content
              h3.quiz-title #{category.title}
              .quiz-author
                i.fa-solid.fa-user
                | Huynh Huu Hoang
              .quiz-stats
                span.quiz-likes
                  i.fa-solid.fa-heart
                  | #{category.approxFavorite}
              a.btn-details(href=`/cards/${category.slug}`) Details