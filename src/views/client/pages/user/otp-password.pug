include ../../mixins/alert.pug

doctype html
head
  meta(charset='UTF-8')
  meta(http-equiv='X-UA-Compatible', content='IE=edge')
  meta(name='viewport', content='width=device-width, initial-scale=1.0')
  title #{titlePage}
  link(rel='stylesheet', href='https://unpkg.com/bootstrap@5.3.2/dist/css/bootstrap.min.css')
  style.
    body {
    background-color: red;
    }
    .card {
    border: none;
    box-shadow: 0px 5px 20px 0px #d2dae3;
    z-index: 1;
    display: flex;
    justify-content: center;
    align-items: center;
    }
    .card h6 {
    color: red;
    font-size: 20px;
    }
    .inputs input {
    width: 40px;
    height: 40px;
    }
    input[type='number']::-webkit-inner-spin-button,
    input[type='number']::-webkit-outer-spin-button {
    -webkit-appearance: none;
    -moz-appearance: none;
    appearance: none;
    margin: 0;
    }
    .card-2 {
    background-color: #fff;
    padding: 10px;
    width: 350px;
    height: 100px;
    bottom: -50px;
    left: 20px;
    position: absolute;
    border-radius: 5px;
    }
    .card-2 .content {
    margin-top: 50px;
    }
    .card-2 .content a {
    color: red;
    }
    .form-control:focus {
    box-shadow: none;
    border: 2px solid red;
    }
    .validate {
    border-radius: 20px;
    height: 40px;
    background-color: red;
    border: 1px solid red;
    width: 140px;
    }
    input[type="otp"] {
      display: none;
    }
    input[type="email"] {
      display: none;
    }
body
  section.bg-light.p-3.p-md-4.p-xl-5
    .container
      .row.justify-content-center
        .col-12.col-xxl-11
          .card.border-light-subtle.shadow-sm
            .row.g-0
              .col-12.col-md-6
                img.img-fluid.rounded-start.w-100.h-100.object-fit-cover(loading='lazy', src='https://bootstrapbrain.com/demo/components/password-resets/password-reset-8/assets/img/logo-img-1.webp', alt="Welcome back you've been missed!")
              .col-12.col-md-6.d-flex.align-items-center.justify-content-center(style='background-color: red')
                .col-12.col-lg-11.col-xl-10
                  .card-body.p-3.p-md-4.p-xl-5
                    +alert-error(3000)
                    .card.p-5.text-center
                      h6
                        | Please enter the OTP code 
                        br
                        |                           to verify your account
                      div
                        span A code has been sent to 
                        small #{email}
                      form(
                        action='/users/password/otp'
                        method="POST"
                      )
                        #otp.inputs.d-flex.flex-row.justify-content-center.mt-2
                          input#first.m-2.text-center.form-control.rounded(type='text', maxlength='1')
                          input#second.m-2.text-center.form-control.rounded(type='text', maxlength='1')
                          input#third.m-2.text-center.form-control.rounded(type='text', maxlength='1')
                          input#fourth.m-2.text-center.form-control.rounded(type='text', maxlength='1')
                          input#fifth.m-2.text-center.form-control.rounded(type='text', maxlength='1')
                          input#sixth.m-2.text-center.form-control.rounded(type='text', maxlength='1')
                        input.form-control(type='otp', name='otp', required='')
                        input.form-control(type='email', name='email', required='', value=`${email}`)
                        .mt-4
                          button.btn.btn-danger.px-4.validate Validate
script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.0.0-beta1/dist/js/bootstrap.bundle.min.js')
script(src='https://cdnjs.cloudflare.com/ajax/libs/jquery/3.2.1/jquery.min.js')
script(src='/client/js/user.js')